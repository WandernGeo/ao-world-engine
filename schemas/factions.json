{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AO World Engine - Generic Factions Template",
    "description": "Customize these factions for your world",
    "version": "1.0.0",
    "_comment": "This is a TEMPLATE. Replace with your own factions.",
    "factions": {
        "faction_a": {
            "name": "Faction A",
            "motto": "Your motto here",
            "philosophy": "your_philosophy",
            "color": "#4ade80",
            "territories": [
                "district_1",
                "district_2"
            ],
            "trust_modifiers": {
                "faction_a": 0.8,
                "faction_b": -0.5,
                "faction_c": 0.0,
                "neutral": 0.0
            },
            "goals": [
                "goal_1",
                "goal_2"
            ],
            "jobs": [
                "job_1",
                "job_2",
                "job_3"
            ]
        },
        "faction_b": {
            "name": "Faction B",
            "motto": "Opposing motto",
            "philosophy": "opposing_philosophy",
            "color": "#60a5fa",
            "territories": [
                "district_3",
                "district_4"
            ],
            "trust_modifiers": {
                "faction_a": -0.5,
                "faction_b": 0.8,
                "faction_c": 0.3,
                "neutral": 0.1
            },
            "goals": [
                "opposing_goal_1",
                "opposing_goal_2"
            ],
            "jobs": [
                "job_4",
                "job_5",
                "job_6"
            ]
        },
        "faction_c": {
            "name": "Governing Body",
            "motto": "Order and stability",
            "philosophy": "authoritarian",
            "color": "#fbbf24",
            "territories": [
                "central_district"
            ],
            "trust_modifiers": {
                "faction_a": 0.0,
                "faction_b": 0.3,
                "faction_c": 0.7,
                "neutral": 0.2
            },
            "goals": [
                "maintain_order",
                "control_resources"
            ],
            "services": {
                "sanitation": {
                    "coverage": "all"
                },
                "power": {
                    "coverage": "all"
                },
                "security": {
                    "coverage": "partial"
                }
            }
        },
        "neutral": {
            "name": "Unaffiliated",
            "motto": "Just surviving",
            "philosophy": "pragmatic",
            "color": "#9ca3af",
            "territories": [
                "mixed_zones"
            ],
            "trust_modifiers": {
                "neutral": 0.5,
                "faction_a": 0.0,
                "faction_b": 0.0,
                "faction_c": 0.0
            }
        }
    },
    "faction_relations": {
        "faction_a_faction_b": {
            "status": "hostile",
            "conflict_probability": 0.3
        },
        "faction_a_faction_c": {
            "status": "tense",
            "conflict_probability": 0.1
        },
        "faction_b_faction_c": {
            "status": "allied",
            "conflict_probability": 0.05
        }
    }
}