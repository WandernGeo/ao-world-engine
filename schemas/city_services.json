{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "RE:ECHO City Services Schema",
    "description": "City infrastructure systems that NPCs interact with",
    "version": "1.0.0",
    "services": {
        "sanitation": {
            "name": "City Sanitation Department",
            "operator": "corporate",
            "description": "Garbage collection, recycling, waste disposal",
            "schedule": {
                "collection_days": {
                    "neon_market": [
                        1,
                        3,
                        5
                    ],
                    "chrome_district": [
                        2,
                        4,
                        6
                    ],
                    "green_zone": [
                        1,
                        4
                    ],
                    "shadow_district": [
                        6
                    ],
                    "central_spire": [
                        1,
                        2,
                        3,
                        4,
                        5
                    ],
                    "the_ruins": []
                },
                "collection_hour": 6
            },
            "workers": {
                "archetype": "sanitation_worker",
                "routine": [
                    {
                        "action": "collect_waste",
                        "time": "6am-2pm",
                        "probability": 0.95
                    },
                    {
                        "action": "return_to_depot",
                        "time": "2pm-3pm",
                        "probability": 0.9
                    }
                ]
            },
            "effects": {
                "uncollected_waste": {
                    "decay_per_day": 0.1,
                    "disease_chance": 0.05,
                    "rat_spawn_chance": 0.1,
                    "citizen_happiness": -0.02
                }
            },
            "rebel_interaction": {
                "hijack_truck": {
                    "probability": 0.05,
                    "use": "smuggling"
                },
                "sabotage_depot": {
                    "probability": 0.02,
                    "effect": "service_disruption"
                }
            }
        },
        "power_grid": {
            "name": "City Power Authority",
            "operator": "corporate",
            "description": "Electricity, neon lighting, essential power",
            "zones": {
                "central_spire": {
                    "reliability": 0.99,
                    "backup": true
                },
                "chrome_district": {
                    "reliability": 0.95,
                    "backup": true
                },
                "neon_market": {
                    "reliability": 0.9,
                    "backup": false
                },
                "green_zone": {
                    "reliability": 0.85,
                    "backup": false,
                    "bio_power": 0.3
                },
                "shadow_district": {
                    "reliability": 0.6,
                    "backup": false
                },
                "the_ruins": {
                    "reliability": 0.2,
                    "backup": false
                }
            },
            "blackout_effects": {
                "crime_increase": 0.3,
                "opportunity_increase": 0.2,
                "hacker_bonus": 0.5,
                "vivi_unaffected": true
            },
            "hacker_actions": {
                "cause_blackout": {
                    "skill_required": 0.7,
                    "duration": "1-6h"
                },
                "restore_power": {
                    "skill_required": 0.5,
                    "reputation_gain": 0.1
                },
                "redirect_power": {
                    "skill_required": 0.8,
                    "from": "rich",
                    "to": "poor"
                }
            }
        },
        "transit": {
            "name": "City Transit Network",
            "operator": "corporate",
            "types": {
                "metro": {
                    "coverage": [
                        "central_spire",
                        "chrome_district",
                        "neon_market"
                    ],
                    "frequency": 10,
                    "capacity": 500,
                    "fare": 2
                },
                "pod": {
                    "coverage": [
                        "central_spire",
                        "chrome_district"
                    ],
                    "frequency": 2,
                    "capacity": 4,
                    "fare": 20
                },
                "walkway": {
                    "coverage": "all",
                    "frequency": 0,
                    "capacity": "unlimited",
                    "fare": 0
                }
            },
            "delays": {
                "causes": [
                    "overcrowding",
                    "power_outage",
                    "sabotage",
                    "accident"
                ],
                "effects": {
                    "citizen_frustration": 0.1,
                    "late_to_work": 0.3,
                    "missed_meeting": 0.2
                }
            },
            "stations_as_social_hubs": true,
            "rebel_targets": [
                "central_station",
                "power_coupling",
                "control_room"
            ]
        },
        "security": {
            "name": "City Security Force",
            "operator": "corporate",
            "patrol_zones": {
                "central_spire": {
                    "presence": 0.9,
                    "response_time": 2
                },
                "chrome_district": {
                    "presence": 0.7,
                    "response_time": 5
                },
                "neon_market": {
                    "presence": 0.5,
                    "response_time": 10
                },
                "green_zone": {
                    "presence": 0.3,
                    "response_time": 15,
                    "vivi_guards": true
                },
                "shadow_district": {
                    "presence": 0.2,
                    "response_time": 30
                },
                "the_ruins": {
                    "presence": 0.0,
                    "response_time": null
                }
            },
            "worker_archetypes": [
                "patrol_guard",
                "detective",
                "enforcer",
                "peacekeeper"
            ],
            "actions": {
                "patrol": {
                    "detects_crime": 0.3,
                    "deters_crime": 0.5
                },
                "investigate": {
                    "solves_crime": 0.4,
                    "duration": "1-7 days"
                },
                "enforce": {
                    "arrests": 0.6,
                    "violence_chance": 0.2
                },
                "peacekeep": {
                    "de_escalates": 0.5,
                    "community_trust": 0.1
                }
            },
            "corruption": {
                "bribable": 0.2,
                "faction_bias": {
                    "corporate": 0.2,
                    "rebel": -0.5
                }
            }
        },
        "emergency": {
            "name": "Emergency Services",
            "operator": "corporate",
            "types": {
                "fire": {
                    "response_time_base": 5,
                    "effectiveness": 0.8,
                    "coverage": "all_except_ruins"
                },
                "medical": {
                    "response_time_base": 8,
                    "save_chance": 0.7,
                    "coverage": "all",
                    "vivi_alternative": "healers"
                },
                "hazmat": {
                    "response_time_base": 15,
                    "coverage": "chrome_district"
                }
            }
        }
    },
    "elections": {
        "types": {
            "district_mayor": {
                "frequency": "yearly",
                "scope": "district",
                "candidates": {
                    "min": 2,
                    "max": 5
                },
                "requires_registration": true
            },
            "council_seat": {
                "frequency": "every_2_years",
                "scope": "city",
                "candidates": {
                    "min": 3,
                    "max": 10
                },
                "faction_sponsored": true
            }
        },
        "voting": {
            "eligible": "all_citizens",
            "method": "blockchain_verified",
            "influences": {
                "faction_loyalty": 0.4,
                "economic_status": 0.2,
                "recent_events": 0.3,
                "propaganda_exposure": 0.1
            }
        },
        "campaign_actions": {
            "rally": {
                "reach": 100,
                "effect": 0.05
            },
            "bribe": {
                "cost": 1000,
                "effect": 0.1,
                "risk": 0.3
            },
            "propaganda": {
                "reach": 500,
                "effect": 0.02
            },
            "debate": {
                "effect": "variable",
                "requires_opponent": true
            }
        }
    },
    "riots": {
        "triggers": {
            "economic_crash": {
                "threshold": 0.3,
                "probability": 0.5
            },
            "faction_violence": {
                "deaths": 10,
                "probability": 0.7
            },
            "election_fraud": {
                "detected": true,
                "probability": 0.8
            },
            "service_failure": {
                "duration": 48,
                "probability": 0.4
            },
            "corporate_scandal": {
                "severity": 0.7,
                "probability": 0.3
            }
        },
        "effects": {
            "property_damage": 0.3,
            "npc_injury_chance": 0.1,
            "npc_death_chance": 0.02,
            "service_disruption": 0.5,
            "opportunity_for_rebels": 0.8
        },
        "npc_reactions": {
            "join_riot": {
                "personality_threshold": {
                    "chaos": 0.6
                },
                "probability": 0.3
            },
            "flee": {
                "probability": 0.5
            },
            "defend_property": {
                "owns_business": true,
                "probability": 0.7
            },
            "help_injured": {
                "personality_threshold": {
                    "altruism": 0.5
                },
                "probability": 0.2
            }
        }
    }
}