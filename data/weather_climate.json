    "weather_generation": {
        "_desc": "Deterministic weather from tick",
        "algorithm": {
            "1": "Get day from tick (tick / 100)",
            "2": "Get month from day",
            "3": "Get season from month",
            "4": "Base probabilities from season",
            "5": "Apply microclimate modifiers for district",
            "6": "Deterministic random from tick seed",
            "7": "Check for special events (almanac)",
            "8": "Return weather state"
        },
        "persistence": {
            "_desc": "Weather doesn't change every tick",
            "min_duration_ticks": 10,
            "max_duration_ticks": 50,
            "transition_ticks": 5
        }
    },
    "dialogue_by_weather": {
