            "visit_family",
            "avoid_enemy"
        ],
        "information": [
            "gather_intel",
            "learn_news",
            "find_contact",
            "verify_rumor",
            "scout_location"
        ]
    },
    "long_term_goals": {
        "_desc": "Medium-term goals (days to weeks)",
        "stability": [
            "save_for_apartment",
            "get_stable_job",
            "pay_off_debt",
            "build_savings",
            "secure_food_supply"
        ],
        "advancement": [
            "get_promotion",
            "learn_new_skill",
            "start_business",
            "gain_reputation",
            "make_connections"
