    "life_aspirations": {
        "_desc": "Core life goals that shape personality",
        "freedom": {
            "description": "Escape oppression, live independently",
            "compatible_factions": [
                "resistance",
                "neutral"
            ],
            "drives": [
                "autonomy",
                "escape",
                "change"
            ]
        },
        "power": {
            "description": "Gain influence and control",
            "compatible_factions": [
                "temple",
                "corps"
            ],
            "drives": [
                "ambition",
                "dominance",
                "respect"
            ]
        },
        "knowledge": {
            "description": "Understand the world and its secrets",
            "compatible_factions": [
                "mystics",
                "neutral"
            ],
            "drives": [
                "curiosity",
                "truth",
                "discovery"
            ]
        },
        "love": {
            "description": "Find and protect loved ones",
            "compatible_factions": [
                "any"
            ],
            "drives": [
                "connection",
                "family",
                "sacrifice"
            ]
        },
        "survival": {
            "description": "Stay alive at any cost",
            "compatible_factions": [
                "underground",
                "neutral"
            ],
            "drives": [
                "caution",
                "pragmatism",
                "self_preservation"
            ]
        },
        "justice": {
            "description": "Right the wrongs of the world",
            "compatible_factions": [
                "resistance",
                "mystics"
            ],
            "drives": [
                "righteousness",
                "sacrifice",
                "truth"
            ]
        },
        "wealth": {
            "description": "Accumulate resources and comfort",
            "compatible_factions": [
                "neutral",
                "corps"
            ],
            "drives": [
                "greed",
                "security",
                "status"
            ]
        },
        "legacy": {
            "description": "Leave a mark on the world",
            "compatible_factions": [
                "any"
            ],
            "drives": [
                "ambition",
                "creation",
                "memory"
            ]
        }
    },
    "memory_types": {
        "_desc": "Types of memories that shape NPC behavior",
        "trauma": [
            "witnessed_violence",
            "lost_family_member",
            "raid_survivor",
            "betrayed_by_friend",
            "imprisoned"
        ],
        "positive": [
            "found_love",
            "helped_stranger",
            "achieved_goal",
            "reunion",
            "moment_of_hope"
        ],
        "formative": [
            "first_job",
            "joined_faction",
            "left_home",
            "learned_skill",
            "met_mentor"
        ],
        "secret": [
            "committed_crime",
            "hidden_identity",
            "forbidden_knowledge",
            "betrayed_faction",
            "witnessed_truth"
        ]
    },
    "goal_selection_rules": {
        "short_term": {
            "weight_by_personality": true,
            "max_active": 3,
            "refresh_rate_ticks": 24
        },
        "long_term": {
            "weight_by_personality": true,
            "weight_by_life_aspiration": true,
            "max_active": 2,
            "refresh_rate_ticks": 240
        },
        "life_aspiration": {
            "determined_at_creation": true,
            "can_change_on_major_event": true
        }
    }
}