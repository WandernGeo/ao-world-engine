    "event_generation": {
        "_desc": "How to generate events from seeds",
        "algorithm": {
            "step1": "seed = hash(npc_id + tick)",
            "step2": "event_type = seed % num_event_types",
            "step3": "parameters = extract_from_seed(event_schema)",
            "step4": "outcome = seed >> 24 % num_outcomes",
            "step5": "store_event(npc_id, tick, event_full)"
        },
        "probability_per_tick": {
            "social": 0.03,
            "combat": 0.01,
            "tech": 0.02,
            "medical": 0.005,
            "mystic": 0.001,
            "world": 0.01
        },
        "sample_generation": {
            "input": "hash('charlie_100_event')",
            "seed": "0xA3F2B1C4E5D6...",
            "event_type_bits": "0-7 → 15 → EVT_MEET",
