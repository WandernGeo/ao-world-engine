        "mode_selection": {
            "_desc": "NPC picks transport mode deterministically based on resources and distance",
            "algorithm": "filter by max_distance >= actual_distance AND affordability, then pick highest utility",
            "utility_formula": "speed_factor * (1 + mood_impact_per_trip) * affordability_weight",
            "affordability_weight": {
                "_desc": "How much cost matters, based on NPC income bracket",
                "low_income": 2.0,
                "mid_income": 1.0,
                "high_income": 0.3
            },
            "seed_template": "{npc_id}_{tick}_transport",
            "_note": "Deterministic: same NPC at same tick always picks the same mode."
        },
        "commute_time": {
            "formula_ticks": "ceil(distance_km / speed_factor * base_ticks_per_km)",
            "base_ticks_per_km": 5,
            "minimum_ticks": 1,
            "maximum_ticks": 20,
            "_examples": {
                "2km_walk": "ceil(2 / 1.0 * 5) = 10 ticks (1 hour)",
                "5km_bus": "ceil(5 / 3.0 * 5) = 9 ticks (~54 min)",
                "10km_train": "ceil(10 / 5.0 * 5) = 10 ticks (1 hour)",
                "8km_car": "ceil(8 / 4.0 * 5) = 10 ticks (1 hour)",
                "3km_bicycle": "ceil(3 / 2.5 * 5) = 6 ticks (36 min)"
