    },
    "timeline_integration": {
        "_desc": "How canon events integrate with simulation",
        "at_tick_lookup": {
            "description": "When simulation reaches a tick with canon event, that event MUST happen",
            "example": "At tick 70080, if charlie is near L052, the Aiche revelation triggers",
            "override_rng": true
        },
        "post_event_state": {
            "description": "After canon event, NPC states update accordingly",
            "example": "After CE_20750312_001, charlie.knows('aiche_is_city') = true"
        }
    },
    "event_propagation": {
        "_desc": "How NPCs learn about events they weren't present for",
        "gossip_system": {
            "witnesses_tell": 3,
            "per_tick": 0.1,
            "decay": 0.05,
            "secret_events_spread_slower": true
        },
        "example": {
            "event": "CE_20750312_001 - Charlie meets Aiche",
            "tick_0": {
                "knows": [
                    "charlie",
                    "aiche"
                ]
            },
            "tick_100": {
                "knows": [
                    "charlie",
                    "aiche",
                    "felix"
                ],
                "felix_knows_limited": true
            },
            "tick_500": {
                "knows": [
                    "charlie",
                    "aiche",
                    "felix",
                    "pixel"
                ]
            },
            "never_knows": [
                "temple_members"
            ]
        }
    }
