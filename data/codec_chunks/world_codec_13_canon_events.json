    "_meta": {
        "description": "Official canon story events permanently stored on Arweave",
        "authority": "Only events signed by canon authorities become official lore",
        "queryable": true,
        "anyone_can_query": "Yes - Arweave is public, anyone can pull official story",
        "immutable": "Once uploaded, canon events cannot be changed"
    },
    "canon_event_schema": {
        "_desc": "Required format for all canon events",
        "required_fields": {
            "event_id": "Unique ID (format: CE_YYYYMMDD_XXX)",
            "tick": "Simulation tick when event occurs",
            "type": "Event type code from events chunk",
            "participants": "Array of NPC IDs involved",
            "location": "Location code where it happens",
            "description": "Human-readable description",
            "outcome": "What happened",
            "consequences": "Effects on world state",
            "canon_level": "core | major | minor | supplemental",
            "episode_ref": "Episode/scene reference if from animation"
        },
        "arweave_tags": [
            {
                "name": "App-Name",
                "value": "AO-World-Engine"
            },
            {
                "name": "Type",
                "value": "canon_event"
            },
            {
                "name": "Event-ID",
                "value": "CE_XXXXXXXX_XXX"
            },
            {
                "name": "Tick",
                "value": "NUMBER"
            },
            {
                "name": "Canon-Level",
                "value": "core|major|minor"
            },
            {
                "name": "Participants",
                "value": "npc1,npc2,npc3"
            },
            {
                "name": "Signed-By",
                "value": "WALLET_ADDRESS"
            }
        ]
    },
