    "arweave_query_examples": {
        "_desc": "How anyone can query canon events from Arweave",
        "get_all_canon_events": {
            "graphql": "{ transactions(tags: [{name: \"App-Name\", values: [\"AO-World-Engine\"]}, {name: \"Type\", values: [\"canon_event\"]}], first: 100) { edges { node { id tags { name value } } } } }"
        },
        "get_events_for_npc": {
            "graphql": "{ transactions(tags: [{name: \"App-Name\", values: [\"AO-World-Engine\"]}, {name: \"Type\", values: [\"canon_event\"]}, {name: \"Participants\", values: [\"charlie\"]}]) { edges { node { id } } } }"
        },
        "get_core_events_only": {
            "graphql": "{ transactions(tags: [{name: \"App-Name\", values: [\"AO-World-Engine\"]}, {name: \"Type\", values: [\"canon_event\"]}, {name: \"Canon-Level\", values: [\"core\"]}]) { edges { node { id } } } }"
        },
        "get_events_at_location": {
            "graphql": "{ transactions(tags: [{name: \"App-Name\", values: [\"AO-World-Engine\"]}, {name: \"Type\", values: [\"canon_event\"]}, {name: \"Location\", values: [\"L011\"]}]) { edges { node { id } } } }"
        }
    },
