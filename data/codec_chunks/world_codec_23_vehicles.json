        "adventurous": {
            "prioritize": "speed",
            "prefer": "sports_car",
            "avoid": "sedan"
        },
        "cautious": {
            "prioritize": "safety",
            "prefer": "suv",
            "avoid": "motorcycle"
        },
        "rebellious": {
            "prioritize": "unusual",
            "modification_chance": 0.8
        }
    },
    "vehicle_selection_algorithm": {
        "description": "How NPCs choose what to drive",
        "steps": [
            "1. Determine affordable tier from NPC wealth",
            "2. Get faction vehicle preferences",
            "3. Apply personality modifiers",
            "4. Check if NPC already owns a vehicle",
            "5. Calculate status vs practicality weight",
            "6. Select vehicle from accessible tier (±1 tier variance)",
            "7. Apply modifications based on faction/personality",
            "8. Calculate maintenance costs"
        ]
    },
    "driving_outfit_correlation": {
        "description": "What NPCs wear correlates with what they drive",
        "rules": [
            "elite_vehicle → upper_tier_clothing",
            "motorbike → tactical_jacket OR synth_leather",
            "public_transit → practical_clothing",
            "sports_car → stylish_clothing",
            "work_vehicle → work_clothing"
        ]
    },
