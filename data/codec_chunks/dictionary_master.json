            "C": "Character",
            "L": "Location",
            "O": "Object",
            "CY": "Cybernetic",
            "W": "Weather",
            "T": "Time",
            "A": "Action",
            "E": "Emotion",
            "CL": "Clothing",
            "SH": "Shoes",
            "HC": "Hair Color",
