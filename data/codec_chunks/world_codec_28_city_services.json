                "50": 0.25,
                "75": 0.60,
                "100": 1.00,
                "125": 1.15,
                "150": 1.25
            },
            "_note": "At 50% budget, services run at only 25% efficiency. Megacorps can lobby to defund public services."
        },
        "service_fees": {
            "_desc": "Fees charged to citizens/companies for service usage. Adjustable per district.",
