        "_inspiration": "Municipal services simulation with budget-efficiency curves — adapted to cyberpunk-noir setting"
    },
    "city_services": {
        "_desc": "All municipal services in RE:ECHO City — each affects citizen happiness, company efficiency, and district land value",
        "budget_system": {
            "_desc": "Service budgets are set as % of baseline. Budget affects efficiency non-linearly.",
            "min_budget_pct": 50,
            "max_budget_pct": 150,
