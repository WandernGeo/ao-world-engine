            "fee_effects_per_pct_above_100": {
                "electricity_consumption": "-0.4%",
                "company_efficiency": "-0.4%",
                "citizen_happiness": "-0.1"
            },
            "fee_services": [
                "roads_parking",
                "electricity",
                "water_sewage",
                "healthcare",
                "garbage",
                "education",
                "transport"
            ]
        },
