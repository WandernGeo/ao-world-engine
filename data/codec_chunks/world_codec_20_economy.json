    "land_value": {
        "_desc": "Property value calculation - Cities: Skylines style",
        "base_factors": {
            "zone_type_multiplier": {
                "ZONE_R4": 5.0,
                "ZONE_C3": 4.0,
                "ZONE_IT": 3.0,
                "ZONE_R1": 2.0,
                "ZONE_C2": 1.5,
                "ZONE_R2": 1.0,
                "ZONE_C1": 0.8,
                "ZONE_I1": 0.6,
                "ZONE_R3": 0.5,
                "ZONE_I2": 0.3,
                "ZONE_I3": 0.1
            }
        },
        "modifiers": {
            "proximity_to_transit": {
                "metro_station": 0.3,
                "bus_stop": 0.1,
                "highway_access": 0.15
            },
            "proximity_to_services": {
                "healthcare": 0.1,
                "education": 0.15,
                "entertainment": 0.05,
                "green_space": 0.2
            },
            "negative_factors": {
                "pollution": -0.3,
                "noise": -0.2,
                "crime": -0.4,
                "industrial_proximity": -0.15
            }
        },
        "calculation": "base * zone_multiplier * (1 + sum(positive_modifiers)) * (1 + sum(negative_modifiers))"
    },
