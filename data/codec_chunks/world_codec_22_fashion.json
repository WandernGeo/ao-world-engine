    "outfit_selection_algorithm": {
        "description": "How NPCs choose what to wear",
        "steps": [
            "1. Determine economic tier from NPC wealth",
            "2. Get faction style preferences",
            "3. Apply personality modifiers",
            "4. Consider neighborhood norms",
            "5. Check occasion (work vs leisure)",
            "6. Select items from accessible tiers",
            "7. Apply randomness (±1 tier variance)",
            "8. Generate outfit code"
        ]
    }
