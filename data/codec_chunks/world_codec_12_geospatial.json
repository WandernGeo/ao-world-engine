    "spatial_queries": {
        "_desc": "Example PostGIS queries for this data",
        "find_locations_in_district": "SELECT * FROM locations WHERE ST_Within(geom, (SELECT geom FROM districts WHERE code = 'D02'))",
        "find_nearest_safe_house": "SELECT *, ST_Distance(geom, ST_MakePoint(-73.9857, 40.6892)) as dist FROM locations WHERE type = 'safe_house' ORDER BY dist LIMIT 1",
        "find_locations_within_radius": "SELECT * FROM locations WHERE ST_DWithin(geom, ST_MakePoint(-73.9857, 40.6892)::geography, 500)",
        "check_if_in_danger_zone": "SELECT danger_level FROM districts WHERE ST_Contains(geom, ST_MakePoint(:lon, :lat))"
    },
