    "custom_language_template": {
        "_desc": "Template for creating a new language",
        "example": {
            "code": "my_lang",
            "name": "My Custom Language",
            "type": "conlang",
            "script": "latin",
            "direction": "ltr",
            "base_language": "en",
            "phonology": {
                "consonants": [
                    "p",
                    "t",
                    "k",
                    "m",
                    "n",
                    "s",
                    "l",
                    "r"
                ],
                "vowels": [
                    "a",
                    "e",
                    "i",
                    "o",
                    "u"
                ],
                "syllable_structure": "CV(C)",
                "stress_pattern": "penultimate"
            },
            "grammar": {
                "word_order": "SVO",
                "case_system": false,
                "number": [
                    "singular",
                    "plural"
                ],
                "tense": [
                    "past",
                    "present",
                    "future"
                ],
                "aspect": [
                    "perfective",
                    "imperfective"
                ],
                "articles": false,
                "gender": false
            },
            "vocabulary": {
                "core_words": {
                    "i": "mi",
                    "you": "ti",
                    "we": "nos",
                    "they": "elos",
                    "yes": "si",
                    "no": "ne",
                    "hello": "sala",
                    "goodbye": "vale",
                    "good": "bona",
                    "bad": "mala",
                    "water": "akwa",
                    "fire": "piro",
                    "earth": "tera",
                    "air": "aero"
                },
                "extensions": {
                    "tech": {},
                    "combat": {},
                    "medical": {},
                    "slang": {}
                }
            },
            "translation_rules": {
                "verb_conjugation": "suffix based on tense",
                "plural_formation": "add -s or -es",
                "adjective_placement": "after noun"
            }
        }
    },
    "translation_system": {
        "_desc": "How to translate between languages in the codec",
        "universal_concept_codes": {
            "_desc": "Language-agnostic concept identifiers. Each verb/noun/etc has a universal code that maps to all languages.",
            "example": {
                "UC_WALK": {
                    "en": "walk",
                    "es": "caminar",
                    "zh": "走",
                    "street_creole": "step-step"
                },
                "UC_RUN": {
                    "en": "run",
                    "es": "correr",
                    "zh": "跑",
                    "street_creole": "jet"
                },
                "UC_HELLO": {
                    "en": "hello",
                    "es": "hola",
                    "zh": "你好",
                    "street_creole": "yo-yo"
                },
                "UC_DANGER": {
                    "en": "danger",
                    "es": "peligro",
                    "zh": "危险",
                    "street_creole": "red-wire"
                }
            }
        },
        "translation_api": {
            "input": {
                "text": "string to translate",
                "from_lang": "source language code",
                "to_lang": "target language code",
                "context": "optional context for disambiguation"
            },
            "output": {
                "translated": "translated text",
                "confidence": "0-1 confidence score",
                "alternatives": [
                    "other possible translations"
