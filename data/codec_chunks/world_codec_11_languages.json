    "_meta": {
        "description": "Extensible language system supporting human languages, in-world languages, and custom invented languages",
        "extensibility": "New languages can be added by following the schema below. Each language has a unique code, grammar rules, and vocabulary mappings."
    },
    "language_schema": {
        "_desc": "Schema for defining any language (human, fictional, or invented)",
        "required_fields": {
            "code": "Unique 3-6 character code (e.g., 'en', 'klingon', 'example_street')",
            "name": "Human-readable name",
            "type": "human | fictional | conlang | pidgin | machine",
            "script": "Writing system (latin, cyrillic, custom, etc.)",
            "direction": "ltr | rtl | vertical",
            "base_language": "Parent language code, or null if original",
            "vocabulary_chunk": "TX ID or file path to vocabulary chunk"
        },
        "optional_fields": {
            "phonology": "Sound system rules",
            "grammar": "Grammatical structures",
            "honorifics": "Social register systems",
            "slang_level": "0-1 formality scale",
            "tech_terms": "Technical vocabulary additions",
            "cultural_notes": "Usage context"
        }
    },
